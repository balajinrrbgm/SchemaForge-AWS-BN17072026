# =============================================================================
# SchemaForge — Environment Variables
# Uses BOTH Aurora PostgreSQL AND DynamoDB (polyglot persistence)
# =============================================================================

# Aurora PostgreSQL — user data, schemas, version history
DATABASE_URL="postgresql://username:password@your-aurora-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/schemaforge?sslmode=require"

# DynamoDB — AI generation cache, export jobs, analytics
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
DYNAMODB_CACHE_TABLE="schemaforge-cache-prod"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-here"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
